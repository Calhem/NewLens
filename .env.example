# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored; never commit it.

# TypeDB connection. Local development uses NewsLens's own container on port 1731
# (see compose.yaml). Inside Docker Compose the address is overridden to typedb:1729.
TYPEDB_ADDRESS=127.0.0.1:1731
TYPEDB_USERNAME=admin
# TypeDB CE's built-in default password. The server is only reachable from this computer.
TYPEDB_PASSWORD=password
TYPEDB_DATABASE=newslens

# No model or search provider keys are used yet (Milestone 1 makes no paid API calls).
