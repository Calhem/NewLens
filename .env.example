# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored; never commit it.

# "development": one computer, everything bound to 127.0.0.1 (as compose.yaml sets up).
# "production": anything shared with other people or computers. It refuses insecure
# defaults, such as TypeDB's default password.
NEWSLENS_ENVIRONMENT=development

# TypeDB connection. Local development uses NewsLens's own container on port 1731
# (see compose.yaml). Inside Docker Compose the address is overridden to typedb:1729.
TYPEDB_ADDRESS=127.0.0.1:1731
TYPEDB_USERNAME=admin
# TypeDB CE's built-in default password: acceptable only in development. To replace it with a
# strong random one (stored here, never shown): uv run python -m scripts.set_typedb_password
TYPEDB_PASSWORD=password
TYPEDB_DATABASE=newslens

# AI model for claim extraction. "none" (the default) never calls a model: articles are still
# retrieved and extracted, and the claims stage is marked as skipped.
# "anthropic" uses Claude (claude-opus-5-5). It costs money: it needs ANTHROPIC_API_KEY AND a
# spending limit set with: uv run python -m scripts.set_budget --limit 5
NEWSLENS_MODEL_PROVIDER=none
ANTHROPIC_API_KEY=
